# Auto detect text files and perform LF normalization
* text=auto

# Source files
*.py text eol=lf
*.js text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md text eol=lf
*.json text eol=lf
*.sql text eol=lf
*.csv text eol=lf

# Binary artifacts
*.joblib binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.mp4 binary
*.webm binary
